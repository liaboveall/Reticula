  "query": "SELECT m.user_id, u.name, u.avatar_url, m.role\n             FROM members m\n             JOIN users u ON u.id = m.user_id\n             WHERE m.workbook_id = $1\n             ORDER BY CASE m.role WHEN 'owner' THEN 0 WHEN 'editor' THEN 1 ELSE 2 END, u.name ASC, m.user_id ASC",
