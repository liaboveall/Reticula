# Local configuration template for reticula-server and local spikes/evals.
# Copy to .env.local (ignored by git) and fill credentials locally. Never commit secrets.

# LLM analyst runtime (disabled by default; fail-closed when enabled without credentials)
RETICULA_LLM_ENABLED=false
RETICULA_LLM_BASE_URL=https://api.openai.com/v1
RETICULA_LLM_MODEL=
RETICULA_LLM_API_KEY=
# Optional reasoning effort hint for endpoints that accept `reasoning_effort` (e.g. low, medium, high)
RETICULA_LLM_REASONING_EFFORT=

# Server AI analyst guardrails and per-user daily quotas
RETICULA_AGENT_DAILY_TOKEN_LIMIT=500000
RETICULA_AGENT_DAILY_RUN_LIMIT=20
RETICULA_MAX_CONCURRENT_AGENT_RUNS=2
RETICULA_AGENT_MAX_STEPS=25
RETICULA_AGENT_MAX_TOKENS_PER_RUN=120000
RETICULA_AGENT_TIMEOUT_SECS=180
