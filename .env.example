# Local configuration template for reticula-server and local spikes/evals.
# Copy to .env.local (ignored by git) and fill credentials locally. Never commit secrets.

# LLM analyst runtime (disabled by default; fail-closed when enabled without credentials)
RETICULA_LLM_ENABLED=false
RETICULA_LLM_PROVIDER=openai-compat
RETICULA_LLM_BASE_URL=https://api.openai.com/v1
RETICULA_LLM_MODEL=
RETICULA_LLM_API_KEY=
# Optional reasoning effort hint for endpoints that accept `reasoning_effort` (e.g. low, medium, high)
RETICULA_LLM_REASONING_EFFORT=
# Per-request upstream HTTP timeout in seconds (default 90, clamped to 5..=600)
RETICULA_LLM_TIMEOUT_SECS=90
# Optional test/dev mode override (`mock` enables deterministic scripted replies; leave empty in production)
RETICULA_LLM_MODE=

# Server AI analyst guardrails and per-user daily quotas
RETICULA_AGENT_DAILY_TOKEN_LIMIT=500000
RETICULA_AGENT_DAILY_RUN_LIMIT=20
RETICULA_MAX_CONCURRENT_AGENT_RUNS=2
RETICULA_AGENT_MAX_STEPS=25
RETICULA_AGENT_MAX_TOKENS_PER_RUN=120000
RETICULA_AGENT_TIMEOUT_SECS=180

# Networks of the reverse proxies whose X-Real-IP names the visitor, separated by
# commas (default: the loopback addresses; infra/compose.yml has its own default).
# The server does not start when it cannot read this.
RETICULA_TRUSTED_PROXIES=127.0.0.0/8,::1/128

# Tables, in bytes: the largest one, all of one owner, and all of them, which the
# hard limit of the server's storage includes
RETICULA_TABLE_MAX_BYTES=536870912
RETICULA_TABLE_USER_QUOTA_BYTES=1073741824
RETICULA_TABLE_TOTAL_BYTES=8589934592
# What uploads of tables leave free on the volume, where the platform can tell
RETICULA_MIN_FREE_BYTES=1073741824
# Bytes of tables per minute: uploads of a user, and downloads of a user or of an
# anonymous address
RETICULA_TABLE_UPLOAD_BYTES_PER_MINUTE=1073741824
RETICULA_TABLE_DOWNLOAD_BYTES_PER_MINUTE=2147483648
# Requests for tables per minute of an anonymous address
RETICULA_TABLE_ANON_RPM=6000
