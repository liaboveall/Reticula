{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": [
      "*.json",
      "*.ts",
      "apps/**",
      "packages/**",
      "tests/**",
      "!!target",
      "!**/dist",
      "!**/dist-spikes",
      "!**/pkg",
      "!**/sim-pkg",
      "!**/xlsx-pkg",
      "!**/table-pkg",
      "!**/generated",
      "!**/public/data"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  }
}
